{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/New_York",
  "schedule": ["* 22-23,0-5 * * *"],
  "labels": ["dependencies"],
  "platformAutomerge": false,

  "nix": {
    "enabled": true
  },

  "kubernetes": {
    "managerFilePatterns": ["/k8s/.+\\.ya?ml$/"]
  },

  "flux": {
    "managerFilePatterns": ["/k8s/.+\\.ya?ml$/"]
  },

  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },

  "packageRules": [
    {
      "description": "Auto-merge routine updates after CI passes",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Major bumps stay manual",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Lock file maintenance updates FlakeHub inputs",
      "matchManagers": ["nix"],
      "matchPackageNames": ["/^https:\\/\\/flakehub\\.com\\/f\\//"],
      "enabled": false
    }
  ],

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
